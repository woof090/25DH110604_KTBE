@model _25DH110604_LTW.Order
@{
    ViewBag.Title = "Cập nhật trạng thái";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h2 style="font-weight: bold;">CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG #@Model.OrderID</h2>
    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.OrderID)

        <div class="form-horizontal" style="max-width: 600px;">
            <div class="form-group">
                <label class="control-label col-md-4">Trạng thái thanh toán</label>
                <div class="col-md-8">
                    <select name="paymentStatus" class="form-control">
                        <option value="Chưa thanh toán" @(Model.PaymentStatus == "Chưa thanh toán" ? "selected" : "")>Chưa thanh toán</option>
                        <option value="Thanh toán tiền mặt" @(Model.PaymentStatus == "Thanh toán tiền mặt" ? "selected" : "")>Thanh toán tiền mặt</option>
                        <option value="Thanh toán chuyển khoản" @(Model.PaymentStatus == "Thanh toán chuyển khoản" ? "selected" : "")>Thanh toán chuyển khoản</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-4">Phương thức giao hàng</label>
                <div class="col-md-8">
                    <select name="shippingMethod" class="form-control">
                        <option value="Giao hàng nhanh" @(Model.ShippingMethod == "Giao hàng nhanh" ? "selected" : "")>Giao hàng nhanh</option>
                        <option value="Giao hàng tiết kiệm" @(Model.ShippingMethod == "Giao hàng tiết kiệm" ? "selected" : "")>Giao hàng tiết kiệm</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-4 col-md-8">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a href="@Url.Action("DetailedOrder", new { id = Model.OrderID })" class="btn btn-default">Hủy</a>
                </div>
            </div>
        </div>
    }
</div>