@model IEnumerable<_25DH110604_LTW.Order>
@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container-fluid">
    <h2 style="font-weight: bold; text-transform: uppercase;">DANH SÁCH ĐƠN HÀNG</h2>
    <hr />

    @using (Html.BeginForm("Index", "Orders", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom: 20px; background: #f8f9fa; padding: 15px; border-radius: 5px;" }))
    {
        <div class="form-group" style="margin-right: 15px;">
            <label>Tên khách hàng:</label>
            <input type="text" name="customerName" class="form-control" value="@ViewBag.CustomerName" placeholder="Nhập tên..." />
        </div>
        <div class="form-group" style="margin-right: 15px;">
            <label>Trạng thái:</label>
            <select name="paymentStatus" class="form-control">
                <option value="">-- Tất cả --</option>
                <option value="Chưa thanh toán" @(ViewBag.PaymentStatus == "Chưa thanh toán" ? "selected" : "")>Chưa thanh toán</option>
                <option value="Thanh toán tiền mặt" @(ViewBag.PaymentStatus == "Thanh toán tiền mặt" ? "selected" : "")>Thanh toán tiền mặt</option>
                <option value="Thanh toán chuyển khoản" @(ViewBag.PaymentStatus == "Thanh toán chuyển khoản" ? "selected" : "")>Thanh toán chuyển khoản</option>
            </select>
        </div>
        <div class="form-group" style="margin-right: 15px;">
            <label>Ngày đặt:</label>
            <input type="date" name="orderDate" class="form-control" value="@ViewBag.OrderDate" />
        </div>
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a href="@Url.Action("Index")" class="btn btn-default">Làm mới</a>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center" style="font-weight: bold;">
            KHÔNG CÓ
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead>
                <tr style="background-color: #e9ecef;">
                    <th>Ngày đặt hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Tổng giá trị</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Phương thức giao hàng</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Sửa lại định dạng ngày vì cột OrderDate chỉ có Date -->
                        <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                        <!-- Sửa FullName thành CustomerName -->
                        <td>@item.Customer.CustomerName</td>
                        <td>@item.TotalAmount.ToString("N2")</td>
                        <td>
                            @if (item.PaymentStatus == "Chưa thanh toán")
                            {
                                <span class="label label-warning">@item.PaymentStatus</span>
                            }
                            else
                            {
                                <span class="label label-success">@item.PaymentStatus</span>
                            }
                        </td>
                        <td>@item.ShippingMethod</td>
                        <td>
                            @Html.ActionLink("Chi tiết đơn hàng", "DetailedOrder", new { id = item.OrderID }, new { @class = "btn btn-info btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-center">
            <ul class="pagination">
                <li class="@(currentPage <= 1 ? "disabled" : "")">
                    <a href="@Url.Action("Index", new { customerName = ViewBag.CustomerName, paymentStatus = ViewBag.PaymentStatus, orderDate = ViewBag.OrderDate, page = currentPage - 1 })">&laquo;</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="@(i == currentPage ? "active" : "")">
                        <a href="@Url.Action("Index", new { customerName = ViewBag.CustomerName, paymentStatus = ViewBag.PaymentStatus, orderDate = ViewBag.OrderDate, page = i })">@i</a>
                    </li>
                }
                <li class="@(currentPage >= totalPages ? "disabled" : "")">
                    <a href="@Url.Action("Index", new { customerName = ViewBag.CustomerName, paymentStatus = ViewBag.PaymentStatus, orderDate = ViewBag.OrderDate, page = currentPage + 1 })">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>